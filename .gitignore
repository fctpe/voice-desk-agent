# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Environment / secrets — never commit credentials
.env
.env.*
!.env.example
*.pem
*.key

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime output
outbox/
transcripts/
metrics/
# Committed eval results back the README's numbers; ignore only stray artifacts.
evals/results/*
!evals/results/reliability.json
!evals/results/evals.json
!evals/results/behaviors.xml
!evals/results/.gitkeep

# Behavior traces are recorded per run. Commit only the one the behavior gate's
# baseline was measured against; the rest are scratch.
evals/traces/*
!evals/traces/cross_caller_cancel.trace.json

# Editors / OS
.idea/
.vscode/
.DS_Store
