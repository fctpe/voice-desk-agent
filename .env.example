# ---------------------------------------------------------------------------
# voice-desk-agent environment configuration
# Copy to .env and fill in what you need. The console demo needs only
# OPENAI_API_KEY (the default "openai" stack uses OpenAI for STT + LLM + TTS).
# ---------------------------------------------------------------------------

# --- Pipeline preset --------------------------------------------------------
# VOICE_DESK_STACK: "openai" (default) uses OpenAI for STT + LLM + TTS, so a
# single OPENAI_API_KEY runs everything. "full" uses Deepgram STT (nova-3) +
# OpenAI LLM + Cartesia TTS (sonic-3) for lower latency and per-stage cost.
VOICE_DESK_STACK=openai

# --- Required for the minimal quickstart ------------------------------------
# Used for the LLM in both stacks, and for STT + TTS in the "openai" stack.
OPENAI_API_KEY=

# --- Required only for VOICE_DESK_STACK=full --------------------------------
# Deepgram STT (nova-3, English).
DEEPGRAM_API_KEY=
# Cartesia TTS (sonic-3). A public Cartesia voice id is used by default.
CARTESIA_API_KEY=

# --- Optional model / voice overrides ---------------------------------------
# LLM model (default: gpt-4.1 — evals showed gpt-4o-mini hallucinates bookings;
# see docs/adr/0005). gpt-4.1-mini is the faster, less-reliable alternative.
LLM_MODEL=
# STT model + language. Defaults: gpt-4o-mini-transcribe / nova-3, language "en".
STT_MODEL=
STT_LANGUAGE=
# TTS model + voice. Leave empty to use the stack defaults.
TTS_MODEL=
TTS_VOICE=

# --- Turn detection ---------------------------------------------------------
# TURN_DETECTION: "vad" (default, fully offline Silero VAD endpointing) or
# "model" (LiveKit 1.6 audio-native Turn Detector; needs LiveKit inference
# credentials and may load a model on first run).
TURN_DETECTION=vad

# --- Optional: LiveKit Cloud / self-hosted server ("dev" / "start" modes) ---
# Not needed for the console demo. Get these from your LiveKit project settings.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Runtime output ---------------------------------------------------------
# Where .ics confirmations, transcripts and metrics reports are written.
OUTBOX_DIR=outbox
TRANSCRIPT_DIR=transcripts
METRICS_DIR=metrics

# --- Demo data --------------------------------------------------------------
# Seed for the in-memory fake calendar/contacts (deterministic demo data).
DEMO_SEED=42
# Simulated provider latency in ms (demonstrates async latency masking) and
# failure injection ("none", "calendar", "confirmation", "contacts").
DEMO_LATENCY_MS=0
DEMO_FAIL=none
